# =============================================
# OctaOS Environment Configuration
# Copy this file to .env and fill in values
# =============================================

# --- Database ---
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=octaos

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- AI Provider Keys ---
ANTHROPIC_API_KEY=CHANGE_ME_YOUR_ANTHROPIC_KEY
OPENAI_API_KEY=CHANGE_ME_YOUR_OPENAI_KEY

# --- SMTP / Email ---
DEV=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CHANGE_ME_YOUR_GMAIL@gmail.com
EMAIL_HOST_PASSWORD=CHANGE_ME_YOUR_APP_PASSWORD
DEFAULT_FROM_EMAIL=CHANGE_ME_YOUR_GMAIL@gmail.com

# --- App / Domain ---
DOMAIN=CHANGE_ME_YOUR_DOMAIN.com
SERVER_IP=CHANGE_ME_YOUR_SERVER_IP

# --- Security ---
SECRET_KEY=CHANGE_ME_RUN_openssl_rand_hex_32
# Optional dedicated Fernet key (else derived from SECRET_KEY)
# ENCRYPTION_KEY=
ENVIRONMENT=production
# Short-lived JWT access tokens (minutes); refresh tokens last REFRESH_TOKEN_EXPIRE_DAYS
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
MFA_REQUIRED=false
# Comma-separated browser origins (do NOT use * in production)
CORS_ORIGINS=https://CHANGE_ME_YOUR_DOMAIN.com
# Protect /metrics
METRICS_TOKEN=CHANGE_ME_OPTIONAL
# Email inbound webhook HMAC (or per-tenant settings.webhook_hmac_secret)
EMAIL_WEBHOOK_HMAC_SECRET=CHANGE_ME_OPTIONAL

# --- Meta / LinkedIn OAuth ---
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Stripe (optional subscription billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BUSINESS=

# --- Enterprise SSO (OIDC) optional ---
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_REDIRECT_URI=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=https://CHANGE_ME_YOUR_DOMAIN.com/api/v1
