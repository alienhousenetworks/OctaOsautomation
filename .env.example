# =============================================
# OctaOS Environment Configuration
# Copy this file to .env and fill in values
# =============================================

# --- Database ---
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=octaos

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- AI Provider & Vendor Keys (Primary + Safety Failovers) ---
DEFAULT_AI_PROVIDER=openrouter
DEFAULT_AI_MODE=inbuilt
# DEFAULT_AI_MODEL=google/gemini-2.5-flash

# Supported Vendor Keys (configure multiple for safety failover)
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
FIRECRAWL_API_KEY=
# Optional self-hosted Firecrawl instance URL (defaults to https://api.firecrawl.dev if empty)
# FIRECRAWL_API_URL=http://localhost:3002

# Optional Custom Model Lists from Env (comma-separated)
# OPENROUTER_MODELS=google/gemini-2.5-flash,deepseek/deepseek-r1,meta-llama/llama-3.3-70b-instruct,anthropic/claude-3.5-sonnet
# TOGETHER_MODELS=meta-llama/Llama-3.3-70B-Instruct-Turbo,deepseek-ai/DeepSeek-R1,deepseek-ai/DeepSeek-V3

# --- SMTP / Email ---
DEV=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CHANGE_ME_YOUR_GMAIL@gmail.com
EMAIL_HOST_PASSWORD=CHANGE_ME_YOUR_APP_PASSWORD
DEFAULT_FROM_EMAIL=CHANGE_ME_YOUR_GMAIL@gmail.com

# --- App / Domain ---
DOMAIN=CHANGE_ME_YOUR_DOMAIN.com
SERVER_IP=CHANGE_ME_YOUR_SERVER_IP

# --- Security ---
SECRET_KEY=CHANGE_ME_RUN_openssl_rand_hex_32
# Optional dedicated Fernet key (else derived from SECRET_KEY)
# ENCRYPTION_KEY=
ENVIRONMENT=production
# JWT access token lifetime (minutes). Default 7 days. Refresh tokens extend sessions further.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# Hide in-app video studio / campaign video gen until ready (true to re-enable)
ENABLE_IN_APP_VIDEO=false
# High per-tenant API burst limit (requests/minute)
TENANT_API_RATE_LIMIT_PER_MINUTE=300
MFA_REQUIRED=false
# Comma-separated browser origins (do NOT use * in production)
CORS_ORIGINS=https://CHANGE_ME_YOUR_DOMAIN.com
# Protect /metrics
METRICS_TOKEN=CHANGE_ME_OPTIONAL
# Email inbound webhook HMAC (or per-tenant settings.webhook_hmac_secret)
EMAIL_WEBHOOK_HMAC_SECRET=CHANGE_ME_OPTIONAL

# --- Meta / LinkedIn OAuth ---
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Stripe (optional / legacy) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BUSINESS=

# --- Razorpay (primary payments — India) ---
# Dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=CHANGE_ME
# Optional webhook secret (Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
# If true, free admin plan switch is blocked (must pay via Razorpay)
RAZORPAY_REQUIRE_PAYMENT=false

# --- Enterprise SSO (OIDC) optional ---
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_REDIRECT_URI=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=https://CHANGE_ME_YOUR_DOMAIN.com/api/v1
